<?xml version="1.0"?>
<robot name="autonomous_box_robot">

  <!-- MATERIALS -->
  <material name="chassis_color">
    <color rgba="0.18 0.18 0.20 1.0"/>
  </material>
  <material name="wheel_rubber">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="wheel_rim">
    <color rgba="0.9 0.4 0.0 1.0"/>
  </material>
  <material name="sensor_blue">
    <color rgba="0.05 0.35 0.85 1.0"/>
  </material>
  <material name="sensor_barrel">
    <color rgba="0.85 0.85 0.85 1.0"/>
  </material>
  <material name="webcam_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="webcam_lens">
    <color rgba="0.1 0.3 0.6 1.0"/>
  </material>
  <material name="oled_screen">
    <color rgba="0.0 0.8 1.0 1.0"/>
  </material>
  <material name="pcb_green">
    <color rgba="0.05 0.45 0.15 1.0"/>
  </material>

  <!-- BASE FOOTPRINT (Ground plane projection) -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.045" rpy="0 0 0"/>
  </joint>

  <!-- CHASSIS BASE LINK (20cm x 20cm x 5cm box) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.20 0.05"/>
      </geometry>
      <material name="chassis_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.20 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.20"/>
      <inertia ixx="0.00425" ixy="0.0" ixz="0.0"
               iyy="0.00425" iyz="0.0"
               izz="0.00800"/>
    </inertial>
  </link>

  <!-- WHEEL MACRO-LIKE DEFINITIONS (4WD Skid Steer) -->
  <!-- FRONT LEFT WHEEL -->
  <link name="wheel_front_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.025"/>
      </geometry>
      <material name="wheel_rubber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.0000316" ixy="0.0" ixz="0.0"
               iyy="0.0000528" iyz="0.0"
               izz="0.0000316"/>
    </inertial>
  </link>
  <joint name="wheel_front_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_left_link"/>
    <origin xyz="0.060 0.1125 -0.0125" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- FRONT RIGHT WHEEL -->
  <link name="wheel_front_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.025"/>
      </geometry>
      <material name="wheel_rubber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.0000316" ixy="0.0" ixz="0.0"
               iyy="0.0000528" iyz="0.0"
               izz="0.0000316"/>
    </inertial>
  </link>
  <joint name="wheel_front_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_right_link"/>
    <origin xyz="0.060 -0.1125 -0.0125" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- REAR LEFT WHEEL -->
  <link name="wheel_rear_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.025"/>
      </geometry>
      <material name="wheel_rubber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.0000316" ixy="0.0" ixz="0.0"
               iyy="0.0000528" iyz="0.0"
               izz="0.0000316"/>
    </inertial>
  </link>
  <joint name="wheel_rear_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_left_link"/>
    <origin xyz="-0.060 0.1125 -0.0125" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- REAR RIGHT WHEEL -->
  <link name="wheel_rear_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.025"/>
      </geometry>
      <material name="wheel_rubber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.0000316" ixy="0.0" ixz="0.0"
               iyy="0.0000528" iyz="0.0"
               izz="0.0000316"/>
    </inertial>
  </link>
  <joint name="wheel_rear_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_right_link"/>
    <origin xyz="-0.060 -0.1125 -0.0125" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 4x HC-SR04 ULTRASONIC SENSOR HUB (Center of robot top surface) -->
  <link name="sonar_hub_link">
    <visual>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.01"/>
      </geometry>
      <material name="chassis_color"/>
    </visual>
  </link>
  <joint name="sonar_hub_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sonar_hub_link"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
  </joint>

  <!-- 1. SONAR FRONT (0 deg, +X) -->
  <link name="sonar_front_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.045 0.020"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.045 0.020"/>
      </geometry>
    </collision>
  </link>
  <joint name="sonar_front_joint" type="fixed">
    <parent link="sonar_hub_link"/>
    <child link="sonar_front_link"/>
    <origin xyz="0.025 0 0.015" rpy="0 0 0"/>
  </joint>

  <!-- 2. SONAR LEFT (+90 deg, +Y) -->
  <link name="sonar_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.045 0.020"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.045 0.020"/>
      </geometry>
    </collision>
  </link>
  <joint name="sonar_left_joint" type="fixed">
    <parent link="sonar_hub_link"/>
    <child link="sonar_left_link"/>
    <origin xyz="0 0.025 0.015" rpy="0 0 1.570796"/>
  </joint>

  <!-- 3. SONAR BACK (180 deg, -X) -->
  <link name="sonar_back_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.045 0.020"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.045 0.020"/>
      </geometry>
    </collision>
  </link>
  <joint name="sonar_back_joint" type="fixed">
    <parent link="sonar_hub_link"/>
    <child link="sonar_back_link"/>
    <origin xyz="-0.025 0 0.015" rpy="0 0 3.141592"/>
  </joint>

  <!-- 4. SONAR RIGHT (-90 deg, -Y) -->
  <link name="sonar_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.045 0.020"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.045 0.020"/>
      </geometry>
    </collision>
  </link>
  <joint name="sonar_right_joint" type="fixed">
    <parent link="sonar_hub_link"/>
    <child link="sonar_right_link"/>
    <origin xyz="0 -0.025 0.015" rpy="0 0 -1.570796"/>
  </joint>

  <!-- 720P OPTIMAL EXTERNAL WEBCAM -->
  <link name="camera_link">
    <!-- Camera mount / stand -->
    <visual>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.03"/>
      </geometry>
      <material name="webcam_black"/>
    </visual>
    <!-- Camera body (horizontal bar webcam style) -->
    <visual>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.080 0.025"/>
      </geometry>
      <material name="webcam_black"/>
    </visual>
    <!-- Camera lens element -->
    <visual>
      <origin xyz="0.016 0 0.005" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.004"/>
      </geometry>
      <material name="webcam_lens"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.080 0.025"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- Positioned at front edge, elevated, slightly tilted down (-0.12 rad ~ 7 deg) -->
    <origin xyz="0.085 0.0 0.055" rpy="0 0.12 0"/>
  </joint>

  <!-- CAMERA OPTICAL LINK (REP-103: Z forward, X right, Y down) -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0.016 0 0.005" rpy="-1.570796 0 -1.570796"/>
  </joint>

  <!-- NODEMCU WITH OLED DISPLAY -->
  <link name="nodemcu_link">
    <!-- NodeMCU PCB Board -->
    <visual>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <geometry>
        <box size="0.055 0.030 0.004"/>
      </geometry>
      <material name="pcb_green"/>
    </visual>
    <!-- OLED Display Module (0.96 inch SSD1306) -->
    <visual>
      <origin xyz="0 0 0.006" rpy="0 0 0"/>
      <geometry>
        <box size="0.028 0.028 0.003"/>
      </geometry>
      <material name="oled_screen"/>
    </visual>
  </link>
  <joint name="nodemcu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="nodemcu_link"/>
    <origin xyz="-0.055 0.0 0.026" rpy="0 0 0"/>
  </joint>

</robot>
