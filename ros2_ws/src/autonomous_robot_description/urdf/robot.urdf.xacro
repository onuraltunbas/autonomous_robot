<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="autonomous_box_robot">

  <!-- PARAMETERS -->
  <xacro:property name="chassis_length" value="0.20"/>
  <xacro:property name="chassis_width"  value="0.20"/>
  <xacro:property name="chassis_height" value="0.05"/>
  <xacro:property name="chassis_mass"   value="1.20"/>

  <xacro:property name="wheel_radius"   value="0.0325"/>
  <xacro:property name="wheel_width"    value="0.025"/>
  <xacro:property name="wheel_mass"     value="0.10"/>
  <xacro:property name="wheelbase"      value="0.120"/>
  <xacro:property name="track_width"    value="0.225"/>

  <!-- Include static URDF as base reference or macro expansions -->
  <xacro:include filename="$(find autonomous_robot_description)/urdf/robot.urdf"/>

</robot>
